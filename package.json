{
  "name": "bailiff",
  "private": true,
  "version": "0.1.0",
  "description": "Bailiff - a case against a company that owes you stays open until their own record proves the outcome",
  "scripts": {
    "dev": "convex dev",
    "backend": "convex dev --once",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "cd web && npm run build",
    "deploy": "npx @convex-dev/static-hosting deploy -d web/out",
    "deploy:upload": "npx @convex-dev/static-hosting upload --build -d web/out"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "^0.2.1",
    "convex": "^1.46.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^26.6.2",
    "convex-test": "^0.0.59",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
