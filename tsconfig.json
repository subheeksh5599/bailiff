{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2022", "dom"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": ["convex/**/*.ts", "tests/**/*.ts"]
}
